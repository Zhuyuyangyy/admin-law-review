    {
      "rule_id": "RULE_AL_010",
      "rule_type": "signature_missing",
      "description": "文书签章缺失",
      "severity": "low",
      "penalty": "补正签章",
      "enabled": true,
      "check_logic": "检测文书是否有当事人、执法人员、负责人签章及行政机关印章"
