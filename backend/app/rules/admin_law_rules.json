      "severity": "medium",
      "penalty": "补正程序",
      "enabled": true,
      "check_logic": "检测各程序节点是否符合法定时限、告知、签章、送达等要求"
    },
    {
      "rule_id": "RULE_AL_006",
      "rule_type": "discretion_abnormal",
      "description": "自由裁量幅度异常",
      "severity": "medium",
      "penalty": "重新裁量",
      "enabled": true,
      "check_logic": "检测处罚幅度是否在裁量基准范围内，考虑违法情节、持续时间等因素"
    },
    {
      "rule_id": "RULE_AL_007",
      "rule_type": "document_format",
      "description": "文书格式不规范",
      "severity": "low",
      "penalty": "整改",
      "enabled": true,
      "check_logic": "检测文书基本要素是否完整，包括案件编号、当事人信息、日期等"
    },
    {
      "rule_id": "RULE_AL_008",
      "rule_type": "evidence_insufficient",
      "description": "证据材料不充分",
      "severity": "medium",
      "penalty": "补充证据",
      "enabled": true,
      "check_logic": "检测每项违法事实是否有至少2项不同类型证据支撑"
    },
    {
      "rule_id": "RULE_AL_009",
      "rule_type": "notice_incomplete",
      "description": "告知程序不完整",
      "severity": "medium",
      "penalty": "补正告知",
