      "rule_type": "unequal_penalty",
      "description": "同案不同罚",
      "severity": "medium",
      "penalty": "重新裁量",
      "enabled": true,
      "check_logic": "检测相同或相似案件事实的处罚结果是否基本一致，偏差是否在合理范围内"
    },
    {
      "rule_id": "RULE_AL_005",
      "rule_type": "procedure_defect",
