{
  "rules": [
    {
      "rule_id": "RULE_AL_001",
      "rule_type": "fact_unclear",
      "description": "事实认定不清",
      "severity": "high",
      "penalty": "责令重新调查",
      "enabled": true,
      "check_logic": "检测案卷中违法事实是否明确、具体，包含时间、地点、行为、结果等要素"
    },
    {
      "rule_id": "RULE_AL_002",
      "rule_type": "evidence_incomplete",
      "description": "证据链不完整",
      "severity": "high",
      "penalty": "责令补充调查",
      "enabled": true,
      "check_logic": "检测事实-证据-法律依据-处罚结果是否形成完整闭环"
    },
    {
      "rule_id": "RULE_AL_003",
